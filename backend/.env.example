# SVN Solutions - Environment Variables Example
PORT=3000
NODE_ENV=production

# MongoDB Atlas Database URI
# Get from Atlas -> Connect -> Drivers -> copy connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/svn_solutions?retryWrites=true&w=majority

# Email (Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
CONTACT_EMAIL=your-email@gmail.com

# Company info
COMPANY_NAME=SVN Solutions
COMPANY_PHONE=+91-6300240474
COMPANY_ADDRESS=India
