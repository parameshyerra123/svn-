# SVN Solutions - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Email Configuration (Gmail SMTP)
# For Gmail: Enable 2FA and create an App Password
# Go to: Google Account > Security > 2-Step Verification > App Passwords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# Where to receive contact form submissions
CONTACT_EMAIL=contact@svnsolutions.com

# Optional: Company info (used in emails)
COMPANY_NAME=SVN Solutions
COMPANY_PHONE=+91-XXXXXXXXXX
COMPANY_ADDRESS=Your City, India
